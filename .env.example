# Copie para .env: cp .env.example .env
# O .env é lido pelo Next.js (fora do Docker) e pelo docker compose.

# [OBRIGATÓRIA] URL pública do frontend.
# Exposta ao navegador e incorporada ao bundle em tempo de build.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [OBRIGATÓRIAS] URLs base dos cinco microsserviços do backend (lucroai-backend),
# usadas somente no servidor. Valores para rodar o front fora do Docker (npm run dev).
# auth-service: empresas, usuários e login
AUTH_API_URL=http://localhost:3001
# catalog-service: insumos e gastos indiretos
CATALOG_API_URL=http://localhost:3002
# recipe-service: receitas, custos e simulação
RECIPE_API_URL=http://localhost:3003
# operations-service: estoque e produções
OPERATIONS_API_URL=http://localhost:3004
# sales-service: vendas
SALES_API_URL=http://localhost:3005

# URLs dos serviços vistas de dentro do container; o docker compose as entrega
# como AUTH_API_URL, CATALOG_API_URL etc. Por padrão, usam as portas que o
# compose do backend publica no host.
DOCKER_AUTH_API_URL=http://host.docker.internal:3001
DOCKER_CATALOG_API_URL=http://host.docker.internal:3002
DOCKER_RECIPE_API_URL=http://host.docker.internal:3003
DOCKER_OPERATIONS_API_URL=http://host.docker.internal:3004
DOCKER_SALES_API_URL=http://host.docker.internal:3005

# Porta do frontend exposta no host pelo docker compose (padrão: 3000).
# Se mudar, ajuste também NEXT_PUBLIC_APP_URL.
WEB_PORT=3000
