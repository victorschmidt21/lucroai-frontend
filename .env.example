# Copie para .env: cp .env.example .env
# O .env é lido pelo Next.js (fora do Docker) e pelo docker compose.

# [OBRIGATÓRIA] URL pública do frontend.
# Exposta ao navegador e incorporada ao bundle em tempo de build.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [OBRIGATÓRIA] URL base da API do Doce Fatia (o monolito lucroai-backend), usada
# somente no servidor. Valor para rodar o front fora do Docker (npm run dev).
API_URL=http://localhost:3100

# URL da API vista de dentro do container; o docker compose a entrega como
# API_URL. Por padrão, usa a porta que o compose do backend publica no host.
DOCKER_API_URL=http://host.docker.internal:3100

# Porta do frontend exposta no host pelo docker compose (padrão: 3000).
# Se mudar, ajuste também NEXT_PUBLIC_APP_URL.
WEB_PORT=3000
